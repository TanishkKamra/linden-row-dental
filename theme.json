{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#F5F1EA" },
				{ "slug": "base-2", "name": "Paper light", "color": "#FBF8F3" },
				{ "slug": "sand", "name": "Sand", "color": "#D9CBB5" },
				{ "slug": "line", "name": "Line", "color": "#DDD3C3" },
				{ "slug": "muted", "name": "Stone", "color": "#5E5B53" },
				{ "slug": "mist", "name": "Mist", "color": "#C2CDC8" },
				{ "slug": "primary", "name": "Spruce", "color": "#1F3D36" },
				{ "slug": "primary-dark", "name": "Deep spruce", "color": "#16302A" },
				{ "slug": "contrast", "name": "Ink", "color": "#1B1B19" }
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "78rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "0.75rem" },
				{ "slug": "30", "name": "3", "size": "1rem" },
				{ "slug": "40", "name": "4", "size": "1.5rem" },
				{ "slug": "50", "name": "5", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(3rem, 6vw, 5rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(4rem, 9vw, 7.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "300 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Instrument Sans",
					"fontFamily": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/instrument-sans.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "2rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "3rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.5rem", "fluid": { "min": "2.375rem", "max": "4.25rem" } },
				{ "slug": "display", "name": "Display", "size": "4.5rem", "fluid": { "min": "2.625rem", "max": "5.25rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1.25rem, 4vw, 3rem)",
				"right": "clamp(1.25rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "1.02",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "500",
					"lineHeight": "1.25",
					"letterSpacing": "-0.005em"
				}
			},
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|contrast" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "6px",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": { "top": "0.8125rem", "bottom": "0.8125rem", "left": "1.375rem", "right": "1.375rem" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|base",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": { "background": "var:preset|color|primary-dark", "text": "var:preset|color|base" },
					"border": { "color": "var(--wp--preset--color--primary-dark)" }
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": { "color": { "text": "var:preset|color|contrast" } }
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing page (no title)", "postTypes": [ "page" ] }
	]
}
